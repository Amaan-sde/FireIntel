# ==============================================================================
# FIREINTEL — Environmental Data Pipeline Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (which is excluded by .gitignore):
#    cp .env.example .env
# 2. Fill in your personal API keys and credentials obtained from official portals.
# 3. NEVER commit your actual '.env' file or credentials to version control.
# 4. NEVER share, log, or hardcode these tokens in codebase scripts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Copernicus Climate Data Store (CDS) API Configuration
# Used for: ERA5-Land (reanalysis-era5-land) hourly downloads
# Portal: https://cds.climate.copernicus.eu/
# Register: Create free account, accept dataset terms in web UI, obtain API key
# Note: You can also place this in ~/.cdsapirc in format:
#   url: https://cds.climate.copernicus.eu/api
#   key: <YOUR-PERSONAL-CDS-API-KEY>
# ------------------------------------------------------------------------------
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=YOUR_CDS_API_KEY_HERE

# ------------------------------------------------------------------------------
# 2. NASA Earthdata Login Configuration
# Used for: NASA AppEEARS (MODIS MOD13Q1/MYD13Q1, VIIRS VNP13A1, SRTMGL1)
#           NASA GES DISC (GPM IMERG v07)
# Portal: https://urs.earthdata.nasa.gov/
# Register: Create free Earthdata Login account and authorize AppEEARS application
# Note: Can also be configured in ~/.netrc with permission 600
# ------------------------------------------------------------------------------
EARTHDATA_USERNAME=YOUR_NASA_EARTHDATA_USERNAME_HERE
EARTHDATA_PASSWORD=YOUR_NASA_EARTHDATA_PASSWORD_HERE

# ------------------------------------------------------------------------------
# 3. OpenTopography Global Datasets API Configuration
# Used for: Copernicus DEM GLO-30 (COP30) or NASA SRTMGL1 v003 subsetting
# Portal: https://portal.opentopography.org/
# Register: Create free account, generate API key under 'myOpenTopo'
# Note: AWS Open Data S3 (registry.opendata.aws/copernicus-dem) allows anonymous read
# ------------------------------------------------------------------------------
OPENTOPOGRAPHY_API_KEY=YOUR_OPENTOPOGRAPHY_API_KEY_HERE

# ------------------------------------------------------------------------------
# 4. Pipeline Execution & Safety Settings
# ------------------------------------------------------------------------------
FIREINTEL_ENV=development
FIREINTEL_LOG_LEVEL=INFO
FIREINTEL_DATA_DIR=fireIntel/data/environmental
FIREINTEL_REQUEST_TIMEOUT_SECONDS=60
FIREINTEL_MAX_RETRIES=5
FIREINTEL_BACKOFF_FACTOR=2.0
FIREINTEL_RATE_LIMIT_DELAY_SECONDS=1.0

