.cdsapirc
.netrc
*.key
*.pem
*.token
*credentials*
*secret*

# Large environmental data binaries and downloads (preserve structure with .gitkeep)
fireIntel/data/environmental/raw/*
!fireIntel/data/environmental/raw/.gitkeep
fireIntel/data/environmental/intermediate/*
!fireIntel/data/environmental/intermediate/.gitkeep
fireIntel/data/environmental/processed/*
!fireIntel/data/environmental/processed/.gitkeep
*.nc
*.nc4
*.grib
*.grib2
*.tif
*.tiff
*.hdf
*.h5
*.part
*.download
*.tmp

